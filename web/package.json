{
  "name": "researchpilot-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:render": "node scripts/render-check.mjs",
    "test:data": "node scripts/data-check.mjs",
    "test:questions": "node scripts/question-picker-check.mjs",
    "test:planning": "node scripts/planning-check.mjs",
    "test:citations": "node scripts/citation-check.mjs",
    "test:claim-review": "node scripts/claim-review-check.mjs",
    "test:execution-review": "node scripts/execution-review-check.mjs",
    "test:library-execution": "node scripts/library-execution-check.mjs",
    "test:coverage": "node scripts/coverage-check.mjs",
    "test:reread": "node scripts/reread-check.mjs",
    "test:supplement-search": "node scripts/supplement-search-check.mjs",
    "test:supplement-readings": "node scripts/supplement-readings-check.mjs",
    "test:execution-review-links": "node scripts/execution-review-links-check.mjs"
  },
  "dependencies": {
    "vue": "3.5.32",
    "vue-router": "4.6.4",
    "pinia": "2.3.1",
    "element-plus": "2.13.7",
    "@element-plus/icons-vue": "2.3.2",
    "axios": "1.15.0"
  },
  "devDependencies": {
    "vite": "5.4.21",
    "@vitejs/plugin-vue": "4.6.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
