# 复制为 .env 后填写；不要提交真实密钥。已有 .env 不要覆盖。
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/researchpilot
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/researchpilot_test
SERPAPI_KEY=
OPENALEX_API_KEY=
# PDF 单地址总时限、连续等待数据时限、建立连接时限（秒），与模型时限分开。
PDF_DOWNLOAD_TIMEOUT=600
PDF_READ_TIMEOUT=60
PDF_CONNECT_TIMEOUT=10
# 可选，默认从 OpenAlex 实时解析各会议来源；显式配置也会核对名称，不使用示例假编号。
# OPENALEX_CVPR_SOURCE_IDS=S已核实的来源编号,S另一个已核实的来源编号
# OPENALEX_ICCV_SOURCE_IDS=S已核实的ICCV来源编号
# OPENALEX_AAAI_SOURCE_IDS=S已核实的AAAI来源编号
# OPENALEX_IJCAI_SOURCE_IDS=S已核实的IJCAI来源编号
# 新增会议/期刊默认自动解析；只有已核实来源编号时才填写以下可选项。
# OPENALEX_ACL_SOURCE_IDS=
# OPENALEX_EMNLP_SOURCE_IDS=
# OPENALEX_SIGIR_SOURCE_IDS=
# OPENALEX_NEURIPS_SOURCE_IDS=
# OPENALEX_AIJ_SOURCE_IDS=
# OPENALEX_TOIS_SOURCE_IDS=
# OPENALEX_ECCV_SOURCE_IDS=
# OPENALEX_ICML_SOURCE_IDS=
# OPENALEX_ICLR_SOURCE_IDS=
# 当前 web_reader.py 使用无 Key 请求；保留此项供后续需要时配置。
JINA_API_KEY=
# openai：原有兼容 API；codex：通过本机 Codex CLI 使用 ChatGPT 登录和账号额度。
LLM_PROVIDER=openai
# codex 模式不使用下方 API Key、地址、LLM_MODEL、HTTP 传输和供应商扩展参数。
# 启动后端的同一系统用户须先执行 codex login，使用 ChatGPT 登录。
CODEX_CLI_PATH=codex
# 可选；留空使用 CLI 内置默认模型，指定时须为账号可用的 Codex 模型。
CODEX_MODEL=
# 默认读取系统代理，仍保留 HTTP_PROXY/HTTPS_PROXY 等环境代理；--no-proxy 会禁用两者。
CODEX_USE_SYSTEM_PROXY=true
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
STRUCTURED_OUTPUT_METHOD=json_schema
# 模型等待时间；页面分析、综述和命令行共用。Codex 模式为单次调用总时限。
LLM_READ_TIMEOUT=400
LLM_MAX_RETRIES=0
# Qwen3.8 等支持 enable_thinking 的模型可设 false，降低信息提取的等待时间。
# 其他模型不支持此扩展参数时留空；留空使用服务默认值。
LLM_ENABLE_THINKING=
# 单次输出 Token 上限；留空使用服务默认值。输出截断会被判定为失败。
LLM_MAX_OUTPUT_TOKENS=
# 详细综述在 API 模式下独立使用此输出预算，不影响单篇分析和问题推荐；Codex 仍由 CLI 管理输出长度。
REVIEW_MAX_OUTPUT_TOKENS=10000
# 辅助语义证据评审单条 API 输出预算；Codex 输出仍由 CLI 管理。
CLAIM_REVIEW_MAX_OUTPUT_TOKENS=2000
# 网页辅助评审每条输入字符上限；超出时标记未评审，不截断原文。
CLAIM_REVIEW_MAX_INPUT_CHARS=24000
# 研究目标理解与计划草拟的 API 输出预算；Codex 模式仍由 CLI 管理输出。
RESEARCH_PLAN_MAX_OUTPUT_TOKENS=6000
# 默认 sdk；确认为 SDK HTTP 传输差异时可切换 requests，仍执行同样的结构和引用校验。
LLM_HTTP_BACKEND=sdk
ANALYSIS_MAX_CHUNKS=6
# 分批分析：每批原文字符预算、每批失败后的额外尝试次数。
ANALYSIS_BATCH_MAX_CHARS=4000
ANALYSIS_BATCH_RETRIES=1
